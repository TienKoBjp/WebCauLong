@model AspNetMvcApp.Models.UserVM
@{
    ViewData["Title"] = "Chỉnh Sửa Tài Khoản";
}

<style>
    .form-page-header {
        margin-bottom: 2rem;
    }

    .form-page-header h1 {
        font-size: 1.6rem;
        font-weight: 700;
        color: var(--text-primary);
        margin-bottom: 0.25rem;
    }

    .form-page-header p {
        color: var(--text-secondary);
        font-size: 0.88rem;
    }

    .form-card {
        background: var(--bg-dark-card);
        border: 1px solid var(--border-light);
        border-radius: 20px;
        padding: 2rem;
        max-width: 600px;
        backdrop-filter: var(--glass-blur);
    }

    .form-group {
        margin-bottom: 1.35rem;
    }

    .form-label {
        display: block;
        color: var(--text-secondary);
        font-size: 0.85rem;
        font-weight: 500;
        margin-bottom: 0.4rem;
    }

    .form-control-custom {
        width: 100%;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid var(--border-light);
        border-radius: 10px;
        padding: 0.75rem 1rem;
        color: var(--text-primary);
        font-size: 0.9rem;
        outline: none;
        transition: var(--transition-normal);
    }

    .form-control-custom:focus {
        border-color: rgba(0, 166, 81, 0.5);
        background: rgba(255, 255, 255, 0.06);
        box-shadow: 0 0 15px rgba(0, 166, 81, 0.12);
    }

    .form-control-custom:disabled, .form-control-custom[readonly] {
        background: rgba(0, 0, 0, 0.05);
        color: var(--text-muted);
        cursor: not-allowed;
    }

    .form-control-custom option {
        background: #ffffff;
        color: var(--text-primary);
    }

    .form-actions {
        display: flex;
        gap: 0.75rem;
        margin-top: 1.75rem;
        padding-top: 1.25rem;
        border-top: 1px solid var(--border-light);
    }

    .btn-submit {
        background: var(--grad-primary);
        border: none;
        color: #fff;
        padding: 0.75rem 1.5rem;
        font-size: 0.9rem;
        font-weight: 600;
        font-family: 'Outfit', sans-serif;
        border-radius: 10px;
        cursor: pointer;
        transition: var(--transition-fast);
        box-shadow: 0 4px 15px rgba(0, 166, 81, 0.3);
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .btn-submit:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(0, 166, 81, 0.4);
    }

    .btn-cancel {
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid var(--border-light);
        color: var(--text-primary);
        padding: 0.75rem 1.5rem;
        font-size: 0.9rem;
        font-weight: 600;
        font-family: 'Outfit', sans-serif;
        border-radius: 10px;
        cursor: pointer;
        transition: var(--transition-fast);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .btn-cancel:hover {
        background: rgba(255, 255, 255, 0.08);
        color: var(--text-primary);
    }

    .validation-error {
        color: #ef4444;
        font-size: 0.78rem;
        margin-top: 0.3rem;
    }
</style>

<div class="form-page-header">
    <h1><i class="fa-solid fa-user-gear" style="color: var(--accent-blue);"></i> Chỉnh Sửa Tài Khoản</h1>
    <p>Thay đổi vai trò hoặc thông tin cơ bản cho tài khoản người dùng.</p>
</div>

<div class="form-card">
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="UserName" />
        <div asp-validation-summary="ModelOnly" class="validation-error"></div>

        <div class="form-group">
            <label asp-for="Email" class="form-label">Email Đăng Nhập</label>
            <input asp-for="Email" class="form-control-custom" placeholder="Nhập địa chỉ email..." />
            <span asp-validation-for="Email" class="validation-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="Role" class="form-label">Quyền Tài Khoản (Role)</label>
            <select asp-for="Role" asp-items="ViewBag.Roles" class="form-control-custom">
                <option value="">-- Chọn vai trò --</option>
            </select>
            <span asp-validation-for="Role" class="validation-error"></span>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-submit">
                <i class="fa-solid fa-floppy-disk"></i> Lưu Thay Đổi
            </button>
            <a asp-action="Index" class="btn-cancel">
                <i class="fa-solid fa-xmark"></i> Hủy
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
