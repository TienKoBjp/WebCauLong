@model AspNetMvcApp.Models.UserVM
@{
    ViewData["Title"] = "Xóa Tài Khoản";
}

<style>
    .form-page-header {
        margin-bottom: 2rem;
    }

    .form-page-header h1 {
        font-size: 1.6rem;
        font-weight: 700;
        color: #ef4444;
        margin-bottom: 0.25rem;
    }

    .form-page-header p {
        color: var(--text-secondary);
        font-size: 0.88rem;
    }

    .form-card {
        background: var(--bg-dark-card);
        border: 1px solid var(--border-light);
        border-radius: 20px;
        padding: 2rem;
        max-width: 600px;
        backdrop-filter: var(--glass-blur);
    }

    .info-label {
        font-size: 0.8rem;
        font-weight: 600;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 0.25rem;
    }

    .info-value {
        font-size: 1rem;
        font-weight: 600;
        color: var(--text-primary);
        margin-bottom: 1.25rem;
    }

    .alert-danger-custom {
        background: rgba(239, 68, 68, 0.08);
        border: 1px solid rgba(239, 68, 68, 0.2);
        color: #ef4444;
        border-radius: 12px;
        padding: 1rem;
        font-size: 0.88rem;
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        margin-bottom: 1.5rem;
    }

    .alert-danger-custom i {
        font-size: 1.1rem;
        margin-top: 0.1rem;
    }

    .form-actions {
        display: flex;
        gap: 0.75rem;
        margin-top: 1.75rem;
        padding-top: 1.25rem;
        border-top: 1px solid var(--border-light);
    }

    .btn-delete-confirm {
        background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
        border: none;
        color: #fff;
        padding: 0.75rem 1.5rem;
        font-size: 0.9rem;
        font-weight: 600;
        font-family: 'Outfit', sans-serif;
        border-radius: 10px;
        cursor: pointer;
        transition: var(--transition-fast);
        box-shadow: 0 4px 15px rgba(239, 68, 68, 0.3);
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .btn-delete-confirm:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(239, 68, 68, 0.4);
    }

    .btn-cancel {
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid var(--border-light);
        color: var(--text-primary);
        padding: 0.75rem 1.5rem;
        font-size: 0.9rem;
        font-weight: 600;
        font-family: 'Outfit', sans-serif;
        border-radius: 10px;
        cursor: pointer;
        transition: var(--transition-fast);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .btn-cancel:hover {
        background: rgba(255, 255, 255, 0.08);
        color: var(--text-primary);
    }
</style>

<div class="form-page-header">
    <h1><i class="fa-solid fa-user-slash"></i> Xác Nhận Xóa Tài Khoản</h1>
    <p>Hành động này không thể hoàn tác. Vui lòng xác nhận trước khi xóa.</p>
</div>

<div class="form-card">
    <div class="alert-danger-custom">
        <i class="fa-solid fa-triangle-exclamation"></i>
        <div>
            <strong>Cảnh báo:</strong> Bạn sắp xóa vĩnh viễn tài khoản người dùng này khỏi hệ thống. Người dùng sẽ không thể đăng nhập bằng tài khoản này nữa.
        </div>
    </div>

    <div>
        <div class="info-label">Email Đăng Nhập</div>
        <div class="info-value">@Model.Email</div>

        <div class="info-label">ID Người Dùng</div>
        <div class="info-value" style="font-family: monospace;">@Model.Id</div>

        <div class="info-label">Vai Trò hiện tại</div>
        <div class="info-value">
            <span class="badge bg-secondary">@Model.Role</span>
        </div>
    </div>

    <form asp-action="DeleteConfirmed" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="form-actions">
            <button type="submit" class="btn-delete-confirm">
                <i class="fa-solid fa-trash-can"></i> Xác Nhận Xóa
            </button>
            <a asp-action="Index" class="btn-cancel">
                <i class="fa-solid fa-xmark"></i> Hủy Bỏ
            </a>
        </div>
    </form>
</div>
