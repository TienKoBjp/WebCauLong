@model AspNetMvcApp.Models.Order
@{
    ViewData["Title"] = "Đặt hàng thành công - Shop Yonex";
    var finalAmount = Model.TotalAmount;
    var transferInfo = $"YONEX SHOP DH {Model.Id}";

    var status = Model.Status;
    int activeStepIndex = 0;
    if (status == "Pending") activeStepIndex = 0;
    else if (status == "Processing") activeStepIndex = 1;
    else if (status == "Shipped") activeStepIndex = 2;
    else if (status == "Delivered") activeStepIndex = 3;
    else if (status == "Cancelled") activeStepIndex = -1;

    double progressPct = activeStepIndex switch
    {
        0 => 0,
        1 => 33.33,
        2 => 66.66,
        3 => 100,
        _ => 0
    };
}

<style>
    .success-container {
        max-width: 800px;
        margin: 3rem auto;
        padding: 0 1rem;
    }

    .success-card {
        background: var(--bg-dark-card);
        border: 1px solid var(--border-light);
        border-radius: 24px;
        padding: 3rem 2rem;
        text-align: center;
        backdrop-filter: var(--glass-blur);
        -webkit-backdrop-filter: var(--glass-blur);
        box-shadow: var(--shadow-soft);
        position: relative;
        overflow: hidden;
    }

    /* Success Icon Animation */
    .success-icon-wrapper {
        width: 80px;
        height: 80px;
        background: rgba(0, 166, 81, 0.1);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1.5rem;
        position: relative;
    }

    .success-icon-wrapper i {
        font-size: 2.5rem;
        color: var(--accent-emerald);
        animation: scaleIn 0.5s ease-out;
    }

    @@keyframes scaleIn {
        0% { transform: scale(0); }
        80% { transform: scale(1.2); }
        100% { transform: scale(1); }
    }

    .success-title {
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-weight: 800;
        font-size: 2rem;
        color: var(--text-primary);
        margin-bottom: 0.5rem;
    }

    .success-subtitle {
        color: var(--text-secondary);
        font-size: 1rem;
        margin-bottom: 2.5rem;
    }

    /* Summary Details Box */
    .order-details-box {
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid var(--border-light);
        border-radius: 16px;
        padding: 1.5rem;
        text-align: left;
        margin-bottom: 2rem;
    }

    body.theme-light .order-details-box {
        background: #ffffff;
        border-color: rgba(0, 0, 0, 0.08);
    }

    .details-row {
        display: flex;
        justify-content: space-between;
        padding: 0.75rem 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.04);
        font-size: 0.92rem;
    }

    .details-row:last-child {
        border-bottom: none;
    }

    .details-label {
        color: var(--text-secondary);
        font-weight: 500;
    }

    .details-value {
        color: var(--text-primary);
        font-weight: 600;
    }

    /* MoMo QR Code Section */
    .momo-payment-box {
        background: linear-gradient(135deg, rgba(165, 0, 100, 0.08) 0%, rgba(165, 0, 100, 0.02) 100%);
        border: 1px solid rgba(165, 0, 100, 0.2);
        border-radius: 20px;
        padding: 2rem;
        margin-bottom: 2rem;
        text-align: center;
    }

    body.theme-light .momo-payment-box {
        background: linear-gradient(135deg, rgba(165, 0, 100, 0.03) 0%, rgba(165, 0, 100, 0.01) 100%);
    }

    .momo-title {
        color: #a50064;
        font-weight: 700;
        font-size: 1.2rem;
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
    }

    .qr-code-img {
        max-width: 250px;
        width: 100%;
        border-radius: 12px;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.15);
        border: 4px solid #ffffff;
        margin: 1rem auto;
        display: block;
    }

    .payment-instruction {
        font-size: 0.85rem;
        color: var(--text-secondary);
        margin-top: 1rem;
        line-height: 1.5;
    }

    .copy-badge {
        background: rgba(255, 255, 255, 0.05);
        padding: 0.25rem 0.5rem;
        border-radius: 6px;
        font-size: 0.8rem;
        cursor: pointer;
        transition: var(--transition-fast);
        border: 1px solid var(--border-light);
        margin-left: 0.5rem;
    }

    .copy-badge:hover {
        background: rgba(255, 255, 255, 0.1);
        color: var(--accent-blue);
    }

    .success-actions {
        display: flex;
        gap: 1rem;
        justify-content: center;
        margin-top: 2rem;
    }

    @@media (max-width: 576px) {
        .success-actions {
            flex-direction: column;
        }
    }

    /* Horizontal Progress Tracker Styles */
    .timeline-wrapper {
        margin: 2.5rem 0 3.5rem;
        padding: 0 1rem;
    }

    .timeline-steps {
        display: flex;
        justify-content: space-between;
        align-items: center;
        position: relative;
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .timeline-steps::before {
        content: '';
        position: absolute;
        top: 25px;
        left: 0;
        right: 0;
        height: 4px;
        background: rgba(255, 255, 255, 0.05);
        z-index: 1;
    }

    body.theme-light .timeline-steps::before {
        background: rgba(0, 0, 0, 0.05);
    }

    .timeline-progress-bar {
        position: absolute;
        top: 25px;
        left: 0;
        height: 4px;
        background: var(--grad-primary);
        z-index: 1;
        transition: width 0.5s ease-in-out;
    }

    .timeline-step {
        position: relative;
        z-index: 2;
        display: flex;
        flex-direction: column;
        align-items: center;
        flex: 1;
        text-align: center;
    }

    .timeline-icon {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        background: var(--bg-dark-card);
        border: 2.5px solid var(--border-light);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        color: var(--text-secondary);
        transition: all 0.4s ease;
        box-shadow: var(--shadow-soft);
    }

    body.theme-light .timeline-icon {
        background: #ffffff;
        border-color: rgba(0,0,0,0.08);
    }

    .timeline-step.active .timeline-icon {
        border-color: #00a651;
        background: rgba(0, 166, 81, 0.1);
        color: #00a651;
        box-shadow: 0 0 15px rgba(0, 166, 81, 0.3);
    }

    .timeline-step.completed .timeline-icon {
        border-color: #00a651;
        background: #00a651;
        color: #ffffff;
    }

    .timeline-step.cancelled .timeline-icon {
        border-color: #ff5e62;
        background: #ff5e62;
        color: #ffffff;
    }

    .timeline-label {
        margin-top: 0.75rem;
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--text-secondary);
        transition: color 0.4s ease;
    }

    .timeline-step.active .timeline-label,
    .timeline-step.completed .timeline-label {
        color: var(--text-primary);
    }
</style>

<div class="success-container">
    <div class="success-card">
        <div class="success-icon-wrapper">
            <i class="fa-solid fa-circle-check"></i>
        </div>
        
        <h1 class="success-title">Đặt Hàng Thành Công!</h1>
        <p class="success-subtitle">Cảm ơn bạn đã lựa chọn mua sắm tại Shop Yonex.</p>

        <!-- Timeline Progress Tracker -->
        <div class="timeline-wrapper">
            @if (activeStepIndex == -1)
            {
                <div class="timeline-steps" style="max-width: 400px; margin: 0 auto;">
                    <div class="timeline-progress-bar" style="width: 100%; background: #ff5e62;"></div>
                    <div class="timeline-step completed">
                        <div class="timeline-icon">
                            <i class="fa-solid fa-file-invoice"></i>
                        </div>
                        <div class="timeline-label">Đã đặt hàng</div>
                    </div>
                    <div class="timeline-step cancelled">
                        <div class="timeline-icon">
                            <i class="fa-solid fa-ban"></i>
                        </div>
                        <div class="timeline-label" style="color: #ff5e62;">Đã hủy</div>
                    </div>
                </div>
            }
            else
            {
                <div class="timeline-steps">
                    <div class="timeline-progress-bar" style="width: @(progressPct)%"></div>
                    
                    <div class="timeline-step @(activeStepIndex == 0 ? "active" : "completed")">
                        <div class="timeline-icon">
                            <i class="fa-solid fa-file-invoice"></i>
                        </div>
                        <div class="timeline-label">Đã đặt hàng</div>
                    </div>

                    <div class="timeline-step @(activeStepIndex == 1 ? "active" : (activeStepIndex > 1 ? "completed" : ""))">
                        <div class="timeline-icon">
                            <i class="fa-solid fa-gears"></i>
                        </div>
                        <div class="timeline-label">Đang chuẩn bị</div>
                    </div>

                    <div class="timeline-step @(activeStepIndex == 2 ? "active" : (activeStepIndex > 2 ? "completed" : ""))">
                        <div class="timeline-icon">
                            <i class="fa-solid fa-truck-fast"></i>
                        </div>
                        <div class="timeline-label">Đang giao hàng</div>
                    </div>

                    <div class="timeline-step @(activeStepIndex == 3 ? "completed" : "")">
                        <div class="timeline-icon">
                            <i class="fa-solid fa-circle-check"></i>
                        </div>
                        <div class="timeline-label">Đã nhận hàng</div>
                    </div>
                </div>
            }
        </div>

        <!-- Order Information Info Box -->
        <div class="order-details-box">
            <h3 style="font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 700; margin-bottom: 1.25rem; font-size: 1.1rem; color: var(--text-primary);">
                <i class="fa-solid fa-file-invoice" style="margin-right: 0.5rem; color: var(--accent-blue);"></i>Thông tin đơn hàng
            </h3>
            
            <div class="details-row">
                <span class="details-label">Mã đơn hàng</span>
                <span class="details-value" style="color: var(--accent-blue);">#@Model.Id</span>
            </div>
            
            <div class="details-row">
                <span class="details-label">Khách hàng nhận</span>
                <span class="details-value">@Model.CustomerName</span>
            </div>

            <div class="details-row">
                <span class="details-label">Số điện thoại</span>
                <span class="details-value">@Model.PhoneNumber</span>
            </div>

            <div class="details-row">
                <span class="details-label">Địa chỉ nhận</span>
                <span class="details-value">@Model.ShippingAddress</span>
            </div>

            <div class="details-row">
                <span class="details-label">Phương thức thanh toán</span>
                <span class="details-value">
                    @if (Model.PaymentMethod == "Momo")
                    {
                        <span style="color: #a50064; font-weight: 700;"><i class="fa-solid fa-wallet me-1"></i> Ví MoMo (Sandbox)</span>
                    }
                    else if (Model.PaymentMethod == "BankQR")
                    {
                        <span style="color: var(--accent-blue); font-weight: 700;"><i class="fa-solid fa-qrcode me-1"></i> QR Ngân hàng</span>
                    }
                    else
                    {
                        <span><i class="fa-solid fa-hand-holding-dollar me-1" style="color: var(--accent-purple);"></i> Tiền mặt khi nhận hàng (COD)</span>
                    }
                </span>
            </div>

            @if (!string.IsNullOrEmpty(Model.CouponCode))
            {
                <div class="details-row">
                    <span class="details-label">Mã giảm giá đã dùng</span>
                    <span class="details-value" style="color: var(--accent-purple); font-weight: 700;">@Model.CouponCode (-@Model.DiscountAmount.ToString("#,##0") đ)</span>
                </div>
            }

            <div class="details-row">
                <span class="details-label">Phí vận chuyển</span>
                <span class="details-value">@(Model.ShippingFee > 0 ? Model.ShippingFee.ToString("#,##0") + " đ" : "Miễn phí")</span>
            </div>

            <div class="details-row" style="border-top: 1px solid rgba(255,255,255,0.08); padding-top: 1rem; margin-top: 0.5rem;">
                <span class="details-label" style="font-size: 1.05rem; font-weight: 700; color: var(--text-primary);">Tổng thanh toán</span>
                <span class="details-value" style="font-size: 1.2rem; color: var(--accent-emerald);">@Model.TotalAmount.ToString("#,##0") đ</span>
            </div>
        </div>

        @if (Model.PaymentMethod == "Momo")
        {
            <div style="background: rgba(165, 0, 100, 0.04); border: 1px solid rgba(165, 0, 100, 0.18); border-radius: 16px; padding: 1.5rem; margin-bottom: 2rem;">
                <p style="margin: 0; font-size: 0.95rem; line-height: 1.6; color: var(--text-secondary);">
                    <i class="fa-solid fa-circle-check" style="color: var(--accent-emerald); font-size: 1.2rem; margin-right: 0.5rem;"></i>
                    Thanh toán qua Ví MoMo Sandbox của bạn đã được ghi nhận thành công. Đơn hàng đang được chuẩn bị.
                </p>
            </div>
        }
        else if (Model.PaymentMethod == "BankQR")
        {
            @if (Model.Status == "Pending")
            {
                <div class="momo-payment-box" style="background: linear-gradient(135deg, rgba(0, 102, 204, 0.08) 0%, rgba(0, 102, 204, 0.02) 100%); border: 1px solid rgba(0, 102, 204, 0.2); border-radius: 20px; padding: 2rem; margin-bottom: 2rem; text-align: center;">
                    <div class="momo-title" style="color: #005baa; font-weight: 700; font-size: 1.25rem; margin-bottom: 1rem; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
                        <i class="fa-solid fa-building-columns"></i> Thông tin chuyển khoản qua mã QR Ngân hàng
                    </div>
                    
                    <img class="qr-code-img" 
                         src="https://img.vietqr.io/image/970422-0383918384-compact2.jpg?amount=@Math.Round(Model.TotalAmount)&addInfo=@(Uri.EscapeDataString(transferInfo))&accountName=SHOP%20YONEX" 
                         alt="VietQR Code" 
                         style="max-width: 250px; width: 100%; border-radius: 12px; box-shadow: 0 8px 30px rgba(0, 0, 0, 0.15); border: 4px solid #ffffff; margin: 1rem auto; display: block;" />
                    
                    <div style="max-width: 400px; margin: 1.5rem auto 0; text-align: left;">
                        <div style="display: flex; justify-content: space-between; border-bottom: 1px solid rgba(255,255,255,0.05); padding: 0.6rem 0; font-size: 0.9rem;">
                            <span style="color: var(--text-secondary);">Ngân hàng</span>
                            <strong style="color: var(--text-primary);">MB BANK (Ngân hàng Quân Đội)</strong>
                        </div>
                        <div style="display: flex; justify-content: space-between; border-bottom: 1px solid rgba(255,255,255,0.05); padding: 0.6rem 0; font-size: 0.9rem;">
                            <span style="color: var(--text-secondary);">Số tài khoản</span>
                            <strong style="color: var(--text-primary);">
                                0799 331 301 
                                <span class="copy-badge" onclick="copyText('0799331301', this)" style="background: rgba(255, 255, 255, 0.05); padding: 0.25rem 0.5rem; border-radius: 6px; font-size: 0.8rem; cursor: pointer; transition: var(--transition-fast); border: 1px solid var(--border-light); margin-left: 0.5rem;">Sao chép</span>
                            </strong>
                        </div>
                        <div style="display: flex; justify-content: space-between; border-bottom: 1px solid rgba(255,255,255,0.05); padding: 0.6rem 0; font-size: 0.9rem;">
                            <span style="color: var(--text-secondary);">Chủ tài khoản</span>
                            <strong style="color: var(--text-primary);">BUI VAN TIEN</strong>
                        </div>
                        <div style="display: flex; justify-content: space-between; border-bottom: 1px solid rgba(255,255,255,0.05); padding: 0.6rem 0; font-size: 0.9rem;">
                            <span style="color: var(--text-secondary);">Số tiền cần chuyển</span>
                            <strong style="color: var(--accent-emerald);">@Model.TotalAmount.ToString("#,##0") đ</strong>
                        </div>
                        <div style="display: flex; justify-content: space-between; padding: 0.6rem 0; font-size: 0.9rem;">
                            <span style="color: var(--text-secondary);">Nội dung chuyển</span>
                            <strong style="color: var(--text-primary);">
                                @transferInfo
                                <span class="copy-badge" onclick="copyText('@transferInfo', this)" style="background: rgba(255, 255, 255, 0.05); padding: 0.25rem 0.5rem; border-radius: 6px; font-size: 0.8rem; cursor: pointer; transition: var(--transition-fast); border: 1px solid var(--border-light); margin-left: 0.5rem;">Sao chép</span>
                            </strong>
                        </div>
                    </div>
                    
                    <p class="payment-instruction" style="font-size: 0.82rem; color: var(--text-secondary); margin-top: 1.5rem; line-height: 1.5; text-align: center;">
                        <i class="fa-solid fa-circle-info" style="color: #005baa; margin-right: 0.35rem;"></i>
                        Hệ thống sẽ duyệt đơn hàng tự động sau khi nhận đủ tiền giao dịch chuyển khoản.
                    </p>
                </div>
            }
            else if (Model.Status == "Cancelled")
            {
                <div style="background: rgba(239, 68, 68, 0.04); border: 1px solid rgba(239, 68, 68, 0.18); border-radius: 16px; padding: 1.5rem; margin-bottom: 2rem;">
                    <p style="margin: 0; font-size: 0.95rem; line-height: 1.6; color: var(--text-secondary); text-align: center;">
                        <i class="fa-solid fa-circle-xmark" style="color: #ef4444; font-size: 1.2rem; margin-right: 0.5rem;"></i>
                        Đơn hàng thanh toán qua QR Ngân hàng này đã bị hủy.
                    </p>
                </div>
            }
            else
            {
                <div style="background: rgba(0, 166, 81, 0.04); border: 1px solid rgba(0, 166, 81, 0.18); border-radius: 16px; padding: 1.5rem; margin-bottom: 2rem;">
                    <p style="margin: 0; font-size: 0.95rem; line-height: 1.6; color: var(--text-secondary); text-align: center;">
                        <i class="fa-solid fa-circle-check" style="color: var(--accent-emerald); font-size: 1.2rem; margin-right: 0.5rem;"></i>
                        Thanh toán chuyển khoản qua QR Ngân hàng của bạn đã được xác nhận thành công. Đơn hàng đang được chuẩn bị.
                    </p>
                </div>
            }
        }
        else
        {
            <div style="background: rgba(0, 166, 81, 0.03); border: 1px solid rgba(0, 166, 81, 0.15); border-radius: 16px; padding: 1.5rem; margin-bottom: 2rem;">
                <p style="margin: 0; font-size: 0.95rem; line-height: 1.6; color: var(--text-secondary);">
                    <i class="fa-solid fa-truck-fast" style="color: var(--accent-emerald); font-size: 1.2rem; margin-right: 0.5rem;"></i>
                    Đơn hàng của bạn sẽ được chuyển đi bằng dịch vụ chuyển phát nhanh. Quý khách vui lòng thanh toán số tiền 
                    <strong style="color: var(--accent-emerald);">@Model.TotalAmount.ToString("#,##0") đ</strong> khi nhận hàng.
                </p>
            </div>
        }

        <div class="success-actions">
            <a href="/" class="btn-primary-custom" style="text-decoration: none; padding: 0.85rem 1.8rem; border-radius: 12px; font-weight: 700;">
                <i class="fa-solid fa-house"></i> Quay về Trang Chủ
            </a>
            <a href="@Url.Action("Profile", "Account")" class="btn-secondary-custom" style="text-decoration: none; padding: 0.85rem 1.8rem; border-radius: 12px; font-weight: 700;">
                <i class="fa-solid fa-list-check"></i> Xem Lịch Sử Đơn Hàng
            </a>
        </div>
    </div>
</div>

<script>
    function copyText(text, btnElement) {
        navigator.clipboard.writeText(text).then(function() {
            var originalText = btnElement.innerText;
            btnElement.innerText = "Đã sao chép!";
            btnElement.style.color = "var(--accent-emerald)";
            setTimeout(function() {
                btnElement.innerText = originalText;
                btnElement.style.color = "";
            }, 1500);
        }).catch(function(err) {
            console.error('Không thể sao chép văn bản: ', err);
        });
    }
</script>
