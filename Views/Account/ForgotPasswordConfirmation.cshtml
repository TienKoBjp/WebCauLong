@{
    ViewData["Title"] = "Xác Nhận Gửi Yêu Cầu";
}

<style>
    .auth-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 70vh;
        padding: 2rem;
    }

    .auth-card {
        background: var(--bg-dark-card);
        border: 1px solid var(--border-light);
        border-radius: 24px;
        padding: 3rem;
        width: 100%;
        max-width: 480px;
        backdrop-filter: var(--glass-blur);
        -webkit-backdrop-filter: var(--glass-blur);
        box-shadow: var(--shadow-soft);
        position: relative;
        overflow: hidden;
    }

    .auth-card::before {
        content: '';
        position: absolute;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(circle at 30% 20%, rgba(0, 166, 81, 0.06) 0%, transparent 50%),
                    radial-gradient(circle at 70% 80%, rgba(255, 107, 0, 0.04) 0%, transparent 50%);
        pointer-events: none;
    }

    .auth-header {
        text-align: center;
        margin-bottom: 2rem;
        position: relative;
    }

    .auth-icon {
        width: 64px;
        height: 64px;
        border-radius: 18px;
        background: rgba(16, 185, 129, 0.1);
        border: 1px solid rgba(16, 185, 129, 0.25);
        color: var(--accent-emerald);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1.25rem;
        font-size: 1.5rem;
    }

    .auth-title {
        font-size: 1.65rem;
        font-weight: 700;
        color: var(--text-primary);
        font-family: 'Outfit', sans-serif;
        margin-bottom: 0.35rem;
    }

    .auth-subtitle {
        color: var(--text-secondary);
        font-size: 0.95rem;
        line-height: 1.6;
    }

</style>

<div class="auth-container">
    <div class="auth-card">
        <div class="auth-header">
            <div class="auth-icon">
                <i class="fa-solid fa-envelope-circle-check"></i>
            </div>
            <h1 class="auth-title">Đã Gửi Yêu Cầu</h1>
            <p class="auth-subtitle">
                Nếu địa chỉ email <strong>@ViewBag.Email</strong> tồn tại trên hệ thống, một hướng dẫn đặt lại mật khẩu đã được gửi đi. Vui lòng kiểm tra hộp thư của bạn.
            </p>
        </div>

        <p class="text-center mt-4 mb-0" style="color: var(--text-secondary);">
            Quay lại <a asp-action="Login" class="text-decoration-none fw-bold" style="color: var(--accent-blue);">Đăng nhập</a>
        </p>
    </div>
</div>
